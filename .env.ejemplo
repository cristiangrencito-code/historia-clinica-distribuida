# ============================================================
#  PLANTILLA DE SECRETOS
#
#  Copiar a .env y poner valores propios:
#      cp .env.ejemplo .env
#
#  .env esta en .gitignore y NO se sube al repositorio. Este
#  fichero de ejemplo si se sube, pero solo con los nombres de
#  las variables, nunca con los valores.
#
#  Si no existe .env, docker compose usa los valores de
#  desarrollo que estan escritos en docker-compose.yml y el
#  endpoint /health del bus lo avisa en el campo
#  "aviso_seguridad". Es a proposito: el sistema arranca con un
#  solo comando para la demo, pero deja claro que no esta
#  configurado para produccion.
# ============================================================

# Secreto con el que se FIRMAN los tokens JWT.
# Lo comparten el bus (que emite) y la app (que valida), asi que
# tiene que ser el mismo en los dos servicios.
# Generar uno con:  openssl rand -hex 32
JWT_SECRETO=cambiar-por-una-cadena-aleatoria-larga

# Cuanto dura un token antes de caducar.
JWT_VIGENCIA_MINUTOS=60

# Credencial de maquina de las sedes y de Mirth, que viaja en la
# cabecera X-Sede-Clave hacia los endpoints /ingesta/*.
# El cargador del canal la inyecta en la configuracion de Mirth.
# Generar una con:  openssl rand -hex 24
SEDE_CLAVE=cambiar-por-una-clave-de-servicio

# Credenciales de PostgreSQL. En la demo son admin/admin porque
# las bases solo escuchan en la red interna de Docker.
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
